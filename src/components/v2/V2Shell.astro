---
import { MAIN_NAV, USLUGE_NAV } from "@/content/nav";
import { vPath } from "@/lib/paths";
import type { SiteVersion } from "@/lib/paths";

interface Props {
  version: SiteVersion;
  title: string;
  lead?: string;
}

const { version, title, lead } = Astro.props;
const home = vPath(version, "/");
---

<div class="v2-shell">
  <header class="v2-header">
    <span class="v2-badge">v2 preview</span>
    <nav class="v2-nav" style="margin-top: 0.75rem">
      <a href={home}>Početna</a>
      {USLUGE_NAV.map((item) => (
        <a href={vPath(version, item.path)}>{item.name}</a>
      ))}
      {MAIN_NAV.map((item) => (
        <a href={vPath(version, item.path)}>{item.name}</a>
      ))}
    </nav>
  </header>
  <main class="v2-main">
    <h1>{title}</h1>
    {lead && <p>{lead}</p>}
    <slot />
    <p style="margin-top: 2rem; color: hsl(var(--muted-foreground)); font-size: 0.875rem">
      v2 dizajn — placeholder. Sadržaj je isti kao v1; vizuelni sistem će biti
      zamenjen kasnije.
    </p>
  </main>
  <footer class="v2-footer">© 2026 OrtoDent — v2 shell</footer>
</div>
