---
import { CITY_SLUGS, getCityBySlug, isLocationCitySlug, localizeLocationText } from "@/lib/locations";
import SiteLayout from "@/layouts/SiteLayout.astro";
import CityLocationsPage from "@/components/site/pages/CityLocations";

export function getStaticPaths() {
  return CITY_SLUGS.map((city) => ({ params: { city } }));
}

const city = Astro.params.city as string;
if (!isLocationCitySlug(city)) return Astro.redirect(`${import.meta.env.BASE_URL}en/locations/`);
const cityData = getCityBySlug(city)!;
---

<SiteLayout locale="en" currentPath={`/en/locations/${city}`} title={`Locations in ${localizeLocationText(cityData.name, "en")} — OrtoDent`}>
  <CityLocationsPage client:load citySlug={city} locale="en" />
</SiteLayout>
