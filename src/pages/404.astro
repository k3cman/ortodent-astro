---
import { sitePath } from "@/lib/paths";
import SiteLayout from "@/layouts/SiteLayout.astro";

const home = sitePath("/");
---

<SiteLayout title="Stranica nije pronađena">
  <main class="min-h-[60vh] flex flex-col items-center justify-center px-6 text-center">
    <h1 class="text-4xl font-bold mb-4">404</h1>
    <p class="text-muted-foreground mb-8">Stranica nije pronađena.</p>
    <a href={home} class="text-primary font-semibold hover:underline">
      Nazad na početnu
    </a>
  </main>
</SiteLayout>
