---
import NotFoundPage from "@/components/site/pages/NotFoundPage";
import SiteLayout from "@/layouts/SiteLayout.astro";
---

<SiteLayout title="Stranica nije pronađena | OrtoDent" locale="sr" currentPath="/404">
  <NotFoundPage client:load />
</SiteLayout>

<style is:global>
  .oc-not-found main { min-height: 680px; display: grid; place-items: center; padding: 116px 0 72px; background: var(--oc-off-white); }
  .oc-not-found__inner { text-align: center; }
  .oc-not-found .oc-eyebrow { align-items: center; }
  .oc-not-found h1 { max-width: 780px; margin: 0 auto 20px; font-size: clamp(48px, 6vw, 76px); line-height: 1.02; }
  .oc-not-found main p:not(.oc-eyebrow) { max-width: 620px; margin: 0 auto; color: var(--oc-gray-500); font-size: 18px; line-height: 1.7; }
  .oc-not-found nav { margin-top: 36px; display: flex; justify-content: center; align-items: center; gap: 28px; flex-wrap: wrap; }
  @media (max-width: 560px) {
    .oc-not-found main { min-height: 600px; }
    .oc-not-found h1 { font-size: 44px; }
    .oc-not-found nav { align-items: stretch; flex-direction: column; gap: 12px; }
  }
</style>
