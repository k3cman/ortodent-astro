---
import { versionStaticPaths } from "@/lib/static-paths";
import { isSiteVersion, vPath, type SiteVersion } from "@/lib/paths";
import V1Layout from "@/layouts/V1Layout.astro";
import V2Layout from "@/layouts/V2Layout.astro";

export function getStaticPaths() {
  return versionStaticPaths();
}

const version = Astro.params.version as string;
if (!isSiteVersion(version)) {
  return Astro.redirect(`${import.meta.env.BASE_URL}v1/`);
}
const v = version as SiteVersion;
const home = vPath(v, "/");
const Layout = v === "v1" ? V1Layout : V2Layout;
---

<Layout title="Stranica nije pronađena">
  <main class="min-h-[60vh] flex flex-col items-center justify-center px-6 text-center">
    <h1 class="text-4xl font-bold mb-4">404</h1>
    <p class="text-muted-foreground mb-8">Stranica nije pronađena.</p>
    <a href={home} class="text-primary font-semibold hover:underline">
      Nazad na početnu
    </a>
  </main>
</Layout>
