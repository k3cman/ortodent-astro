---
import { versionStaticPaths } from "@/lib/static-paths";
import { isSiteVersion, type SiteVersion } from "@/lib/paths";
import V1Layout from "@/layouts/V1Layout.astro";
import V2Layout from "@/layouts/V2Layout.astro";
import V1Informacije from "@/components/v1/pages/Informacije";
import V2Shell from "@/components/v2/V2Shell.astro";

export function getStaticPaths() {
  return versionStaticPaths();
}

const version = Astro.params.version as string;
if (!isSiteVersion(version)) {
  return Astro.redirect(`${import.meta.env.BASE_URL}v1/informacije/`);
}
const v = version as SiteVersion;
---

{v === "v1" ? (
  <V1Layout title="Informacije — OrtoDent">
    <V1Informacije client:load version={v} />
  </V1Layout>
) : (
  <V2Layout title="Informacije — OrtoDent">
    <V2Shell version={v} title="Informacije">
      <p>FAQ i informacije za pacijente — isti sadržaj kao v1, u pripremi za v2 layout.</p>
    </V2Shell>
  </V2Layout>
)}
