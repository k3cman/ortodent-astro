---
import { versionStaticPaths } from "@/lib/static-paths";
import { isSiteVersion, type SiteVersion } from "@/lib/paths";
import V1Layout from "@/layouts/V1Layout.astro";
import V2Layout from "@/layouts/V2Layout.astro";
import V1Cenovnik from "@/components/v1/pages/Cenovnik";
import V2Shell from "@/components/v2/V2Shell.astro";
import { CENOVNIK_SECTIONS } from "@/content/cenovnik";

export function getStaticPaths() {
  return versionStaticPaths();
}

const version = Astro.params.version as string;
if (!isSiteVersion(version)) {
  return Astro.redirect(`${import.meta.env.BASE_URL}v1/cenovnik/`);
}
const v = version as SiteVersion;
---

{v === "v1" ? (
  <V1Layout title="Cenovnik — OrtoDent">
    <V1Cenovnik client:load version={v} />
  </V1Layout>
) : (
  <V2Layout title="Cenovnik — OrtoDent">
    <V2Shell version={v} title="Cenovnik">
      <ul style="list-style: none; padding: 0; margin: 0">
        {CENOVNIK_SECTIONS.map((section) => (
          <li style="margin-bottom: 1.5rem">
            <strong>{section.title}</strong>
            {section.subtitle && <p style="margin: 0.25rem 0">{section.subtitle}</p>}
            <ul>
              {section.items.map((item) => (
                <li>
                  {item.label}: <strong>{item.amount} din</strong>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </V2Shell>
  </V2Layout>
)}
