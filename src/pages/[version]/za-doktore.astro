---
import { versionStaticPaths } from "@/lib/static-paths";
import { isSiteVersion, type SiteVersion } from "@/lib/paths";
import V1Layout from "@/layouts/V1Layout.astro";
import V2Layout from "@/layouts/V2Layout.astro";
import V1ZaDoktore from "@/components/v1/pages/ZaDoktore";
import V2Shell from "@/components/v2/V2Shell.astro";

export function getStaticPaths() {
  return versionStaticPaths();
}

const version = Astro.params.version as string;
if (!isSiteVersion(version)) {
  return Astro.redirect(`${import.meta.env.BASE_URL}v1/za-doktore/`);
}
const v = version as SiteVersion;
---

{v === "v1" ? (
  <V1Layout title="Za stomatologe — OrtoDent">
    <V1ZaDoktore client:load version={v} />
  </V1Layout>
) : (
  <V2Layout title="Za stomatologe — OrtoDent">
    <V2Shell version={v} title="Za stomatologe">
      <p>OrtoCloud pristup i forma za stomatologe — v2 dizajn TBD.</p>
    </V2Shell>
  </V2Layout>
)}
