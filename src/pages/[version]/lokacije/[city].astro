---
import { versionStaticPaths } from "@/lib/static-paths";
import {
  CITY_SLUGS,
  getCityBySlug,
  isLocationCitySlug,
} from "@/lib/locations";
import { isSiteVersion, type SiteVersion } from "@/lib/paths";
import V1Layout from "@/layouts/V1Layout.astro";
import V2Layout from "@/layouts/V2Layout.astro";
import V1CityLocations from "@/components/v1/pages/CityLocations";
import V2Shell from "@/components/v2/V2Shell.astro";

export function getStaticPaths() {
  return versionStaticPaths().flatMap(({ params }) =>
    CITY_SLUGS.map((city) => ({
      params: { version: params.version, city },
    })),
  );
}

const version = Astro.params.version as string;
const city = Astro.params.city as string;

if (!isSiteVersion(version) || !isLocationCitySlug(city)) {
  return Astro.redirect(`${import.meta.env.BASE_URL}v1/lokacije/`);
}

const v = version as SiteVersion;
const cityData = getCityBySlug(city)!;
const title = `Lokacije ${cityData.name} — OrtoDent`;
---

{v === "v1" ? (
  <V1Layout title={title}>
    <V1CityLocations client:load version={v} citySlug={city} />
  </V1Layout>
) : (
  <V2Layout title={title}>
    <V2Shell version={v} title={`Lokacije — ${cityData.name}`}>
      <p>Mapa i lokacije u gradu {cityData.name} — novi layout u v2.</p>
    </V2Shell>
  </V2Layout>
)}
