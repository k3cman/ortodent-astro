---
import { versionStaticPaths } from "@/lib/static-paths";
import {
  LOCATIONS,
  getLocationBySlug,
  isLocationCitySlug,
} from "@/lib/locations";
import { isSiteVersion, type SiteVersion } from "@/lib/paths";
import V1Layout from "@/layouts/V1Layout.astro";
import V2Layout from "@/layouts/V2Layout.astro";
import V1LocationDetail from "@/components/v1/pages/LocationDetail";
import V2Shell from "@/components/v2/V2Shell.astro";

export function getStaticPaths() {
  return versionStaticPaths().flatMap(({ params }) =>
    LOCATIONS.map((location) => ({
      params: {
        version: params.version,
        city: location.citySlug,
        location: location.slug,
      },
    })),
  );
}

const version = Astro.params.version as string;
const city = Astro.params.city as string;
const locationSlug = Astro.params.location as string;

if (!isSiteVersion(version) || !isLocationCitySlug(city)) {
  return Astro.redirect(`${import.meta.env.BASE_URL}v1/lokacije/`);
}

const location = getLocationBySlug(city, locationSlug);

if (!location) {
  return Astro.redirect(`${import.meta.env.BASE_URL}${version}/lokacije/${city}/`);
}

const v = version as SiteVersion;
const title = `${location.name}, ${location.city} — OrtoDent`;
---

{v === "v1" ? (
  <V1Layout title={title}>
    <V1LocationDetail
      client:load
      version={v}
      citySlug={city}
      locationSlug={locationSlug}
    />
  </V1Layout>
) : (
  <V2Layout title={title}>
    <V2Shell version={v} title={`${location.name} — ${location.city}`}>
      <p>{location.address}</p>
    </V2Shell>
  </V2Layout>
)}
